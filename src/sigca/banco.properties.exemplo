# ---------------------------------------------------------------------
# SIGCA — configuração de conexão com o banco de dados
#
# COPIE este arquivo para "banco.properties" na mesma pasta e preencha
# com os dados da sua instalação. O banco.properties NÃO é versionado
# no Git (ver .gitignore): é nele que fica a senha.
# ---------------------------------------------------------------------

banco.url=jdbc:postgresql://localhost:5432/sigca
banco.usuario=postgres
banco.senha=troque-pela-sua-senha
